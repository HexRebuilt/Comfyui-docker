# Copy to .env and fill in what you need. Every value is optional:
# `docker compose up -d` works with no .env at all.

# --- API keys -------------------------------------------------------------
# Both are optional. Without them, gated models and rate limits apply.
# HuggingFace: https://huggingface.co/settings/tokens
HF_TOKEN=
# Civitai: https://civitai.com/settings/api
# Only used by custom nodes that read it; ComfyUI itself does not.
CIVITAI_API_KEY=

# --- Updates --------------------------------------------------------------
# Pull the latest ComfyUI at container start. See the note on supply-chain
# risk in the README before enabling this on a machine that runs untrusted
# workflows or custom nodes.
AUTO_UPDATE=true
# How often to re-check for updates while running. Accepts any value `sleep`
# understands: 30m, 6h, 1d. Set to an empty value to check only at startup.
UPDATE_INTERVAL=24h
# Set to false to skip the in-container scheduler entirely.
ENABLE_CRON=true

# --- Host identity --------------------------------------------------------
# The container runs as this uid:gid so bind-mounted ./models and ./output are
# writable without root. Match it to your host user:
#   id -u && id -g
PUID=1000
PGID=1000