# syntax=docker/dockerfile:1.7
#
# MCP server for ComfyUI, built so an AI client can drive the ComfyUI container.
#
# This is a SEPARATE image from the main ComfyUI one, on purpose:
#   - the MCP server needs no GPU and no CUDA, so it stays ~150 MB instead of
#     tens of gigabytes;
#   - it ships a different licence (AGPL-3.0-or-later OR Commercial), so it must
#     not be baked into the MIT-licensed ComfyUI image;
#   - it is spawned per session by the MCP client, not run as a long-lived
#     service.
#
# The server is stdio: your AI client runs it as a subprocess and speaks MCP over
# stdin/stdout. `docker run -i` is the standard way to containerise that, and
# docs/MCP.md has the client snippets.
FROM python:3.12-slim

ARG COMFY_CLI_MIN=1.14.0
# Unpinned: the image ships a baseline, and mcp-entrypoint.sh upgrades both to
# the latest PyPI release at container start. CI also rebuilds weekly, so a
# fresh pull is also a refresh.
ARG COMFY_MCP_SPEC=comfy-mcp
ARG COMFY_CLI_SPEC=comfy-cli>=${COMFY_CLI_MIN}
# fastmcp is used only by the optional HTTP bridge. comfy-mcp is stdio-only, so
# re-publishing it over the network needs an HTTP server; fastmcp is the
# SDK-adjacent way to do that without hand-rolling protocol translation.
ARG FASTMCP_SPEC=fastmcp>=4,<5
# Shallow clones of the ComfyUI workspace. Only the git metadata and sources are
# needed so comfy-cli can resolve a workspace path; no models, no pip install.
# Measured at ~2 MB total, not the ~1 GB a full ComfyUI checkout would suggest.
ARG COMFYUI_REF=master
ARG COMFYUI_MANAGER_REF=main

# git is not optional: comfy-cli shells out to it, and its absence makes
# workspace-backed tools crash rather than degrade.
# ca-certificates is needed for HTTPS to PyPI and the HF/GitHub endpoints.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

# Two separate installs on purpose. comfy-mcp deliberately does not depend on
# comfy-cli: it runs whichever `comfy` is on PATH and enforces the version floor
# at runtime, so pinning a second copy here would be the wrong engine.
#
# The account and its config/cache dirs are created in the same layer because
# comfy-cli writes $HOME/.config/comfy-cli on first use, and it must already be
# owned by the runtime user.
RUN pip install --no-cache-dir ${COMFY_CLI_SPEC} ${COMFY_MCP_SPEC} ${FASTMCP_SPEC} \
    && useradd --create-home --uid 1000 --shell /bin/bash comfy \
    && mkdir -p /home/comfy/.config /home/comfy/.cache \
    && chown -R 1000:1000 /home/comfy

# A ComfyUI workspace for comfy-cli to resolve. Without it, most comfy-cli
# commands abort with "not a valid ComfyUI workspace" before doing anything,
# even though they only need HTTP to reach the running server.
#
# ComfyUI-Manager is cloned because comfy-cli's node commands look for its
# `cm_cli` module. NOTE: current ComfyUI-Manager ships `cm-cli.py`, not an
# importable `cm_cli` module, so node introspection still fails with
# "ComfyUI-Manager not found". That is an upstream mismatch between comfy-cli
# and ComfyUI-Manager, not something this image can fix; see docs/MCP.md.
RUN git clone --quiet --depth 1 --branch "${COMFYUI_REF}" \
        https://github.com/Comfy-Org/ComfyUI.git /home/comfy/ComfyUI-ws \
    && git clone --quiet --depth 1 --branch "${COMFYUI_MANAGER_REF}" \
        https://github.com/Comfy-Org/ComfyUI-Manager.git \
        /home/comfy/ComfyUI-ws/custom_nodes/ComfyUI-Manager \
    && chown -R 1000:1000 /home/comfy/ComfyUI-ws

# Path to the baked workspace. Exported so tooling can reference it, and applied
# by mcp-entrypoint.sh at startup -- NOT here, because comfy-cli writes its
# config to $HOME/.config and HOME is only correct from the next line on. Running
# set-default as root at build time silently wrote the config to /root instead.
ENV COMFY_WORKSPACE=/home/comfy/ComfyUI-ws

ENV HOME=/home/comfy \
    XDG_CONFIG_HOME=/home/comfy/.config \
    XDG_CACHE_HOME=/home/comfy/.cache \
    # Reaches the ComfyUI service by its compose service name over the shared
    # docker network, so no host port mapping is required.
    COMFYUI_URL=http://comfyui:8188 \
    # Read by comfy-cli itself rather than by the MCP server. Setting it keeps
    # system_stats/free_memory pointed at the same ComfyUI the run tools submit
    # to, which upstream documents as NOT following COMFYUI_URL on its own.
    COMFY_LOCAL_URL=http://comfyui:8188 \
    AUTO_UPDATE=true \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY --chmod=0755 mcp-entrypoint.sh /usr/local/bin/mcp-entrypoint.sh
COPY --chmod=0755 mcp-http-bridge.py /usr/local/bin/mcp-http-bridge.py
COPY --chmod=0755 mcp-loopback-proxy.py /usr/local/bin/mcp-loopback-proxy.py

# The startup updater reinstalls comfy-mcp and comfy-cli, and pip replaces more
# than the package: it also rewrites the console scripts in /usr/local/bin. Both
# that directory and site-packages must belong to the runtime user, or every
# real upgrade dies with PermissionError on /usr/local/bin/comfy while the
# container still starts and looks healthy.
RUN touch /var/log/mcp-update.log \
    && chown -R 1000:1000 /usr/local/lib/python3.12/site-packages /usr/local/bin \
    && chown 1000:1000 /var/log/mcp-update.log

USER 1000:1000
WORKDIR /home/comfy

ENTRYPOINT ["/usr/local/bin/mcp-entrypoint.sh"]